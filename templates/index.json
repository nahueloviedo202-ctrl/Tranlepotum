              },
              "block_order": [
                "text_yAdWfG"
              ]
            },
            "accordion_row_bHEdG6": {
              "type": "_accordion-row",
              "settings": {
                "heading": "What is your return and refund policy?",
                "open_by_default": false,
                "icon": "none",
                "width": 20
              },
              "blocks": {
                "text_yF9zXw": {
                  "type": "text",
                  "settings": {
                    "text": "<p>Because our products are digital downloads that cannot be returned once delivered, all sales are generally final. However, your build success is our priority. If you encounter any technical issues with your download file or have questions about a plan, contact our builder support and we will gladly help or resolve it.</p>",
                    "width": "fit-content",
                    "max_width": "none",
                    "alignment": "left",
                    "type_preset": "rte",
                    "font": "var(--font-body--family)",
                    "font_size": "",
                    "font_size_mobile": "",
                    "line_height": "normal",
                    "letter_spacing": "normal",
                    "case": "none",
