            "padding-inline-end": 0
          },
          "blocks": {
            "accordion_row_aLDRjA": {
              "type": "_accordion-row",
              "name": "t:names.accordion_row",
              "settings": {
                "heading": "What formats are included in the download?",
                "open_by_default": false,
                "icon": "none",
                "width": 20
              },
              "blocks": {
                "text_AnViXi": {
                  "type": "text",
                  "settings": {
                    "text": "<p>All plans come in high-resolution, printable PDF format. They feature detailed 3D step-by-step assembly diagrams, optimized lumber cut lists, and millimeter dimensions that work seamlessly on screen or printed on paper.</p><p></p>",
                    "width": "fit-content",
                    "max_width": "none",
                    "alignment": "center",
                    "type_preset": "rte",
                    "font": "var(--font-body--family)",
                    "font_size": "1rem",
