                    "padding-inline-end": 0
                  },
                  "blocks": {}
                }
              },
              "block_order": [
                "text_yF9zXw"
              ]
            },
            "accordion_row_bWLCLY": {
              "type": "_accordion-row",
              "name": "t:names.accordion_row",
              "settings": {
                "heading": "Are these plans suitable for beginners with basic tools?",
                "open_by_default": false,
                "icon": "none",
                "width": 20
              },
              "blocks": {
                "text_jMNdL7": {
                  "type": "text",
                  "name": "t:names.text",
                  "settings": {
                    "text": "<p>Yes, absolutely. Every guide clearly lists the exact tools, lumber sizes, and hardware needed before you make your first cut. We focus on designs that can be built using standard workshop tools (circular saw, drill, pocket hole jig, and sander) without requiring industrial machinery.</p>",
                    "width": "fit-content",
                    "max_width": "none",
                    "alignment": "left",
                    "type_preset": "rte",
